# Copie este arquivo como .env.local (ou cadastre as mesmas variáveis na Vercel).
# Nunca coloque valores reais neste arquivo: o repositório é público.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do site (usado nos e-mails de confirmação e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Inteligência artificial (Fase 6). Fica só no servidor — nunca use o prefixo NEXT_PUBLIC_.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Mostre o botão "Continuar com Google" só depois de ativar o provedor no Supabase
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
